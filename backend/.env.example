# Copy to backend/.env for local dev. In production these are set as Render
# env vars (see render.yaml), NOT from this file.

# SQLAlchemy async URL. Supabase pooler example:
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:6543/postgres?ssl=require

# Long random string. Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated exact browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Public URL of this API (optional; used for absolute upload URLs).
PUBLIC_BASE_URL=

HUGGINGFACE_API_TOKEN=
HUGGINGFACE_MODEL_URL=https://api-inference.huggingface.co/models/openai/clip-vit-base-patch32

LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
LLM_API_URL=https://api.groq.com/openai/v1/chat/completions

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

GOOGLE_PLACES_API_KEY=
